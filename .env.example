# PostgreSQL (the database is created automatically if it does not exist)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vendorcrm
PORT=4100
JWT_SECRET=change-me

# First owner login, created on first start
ADMIN_EMAIL=owner@vendorcrm.local
ADMIN_PASSWORD=owner123
COMPANY_NAME=My Marketplace

# AI insights. With a key, Claude reads each conversation. Without one, a built-in
# rule engine (English + Roman Urdu) is used so the app still works offline.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-haiku-5-5

# Chat source. Leave empty to use the demo data. Sendbird credentials stay on the server.
# SENDBIRD_API=https://api-XXXX.sendbird.com/v3
# SENDBIRD_TOKEN=...
